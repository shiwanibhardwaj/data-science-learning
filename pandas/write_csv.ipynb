    "import pandas as pd \n",
    "data=pd.read_csv(\"titanic/train.csv\")\n",
    "data2=data.copy()\n",
    "data2=data2.drop_duplicates()\n",
    "data2=data2.fillna(0)\n",
    "data2=data2.sort_values(\"Age\")\n",
    "data2=data2.reset_index(drop=True)\n",
    "data2.to_csv(\"sorted_dataset.csv\")"
   ]
